<main class="wrap">
  <section class="header">
    <div>
      <h1>Build your bouquet</h1>
    </div>
  </section>

  <section class="layout">
    <div class="visual">
      <div class="visual-card">
        <div class="visual-contents" id="visual-contents"></div>
      </div>
    </div>

    <div class="config">
      <div class="step">
        <h2 class="step-title">Flowers</h2>
        <div class="options">
          <button class="option active" data-type="flower" data-value="rose">
            <div>
              <strong>Rose</strong>
              <p>Roses are classic elegance. The color of roses depends on the color you choose bellow.</p>
            </div>
            <div class="meta">$20</div>
          </button>

          <button class="option" data-type="flower" data-value="sunflower">
            <div>
              <strong>Sunflower</strong>
              <p>Bright sunflowers symbolize happiness and cheer.</p>
            </div>
            <div class="meta">$20</div>
          </button>
          <button class="option" data-type="flower" data-value="lily">
            <div>
              <strong>Lily</strong>
              <p>Lilies provide a soft, feminine grace.</p>
            </div>
            <div class="meta">$20</div>
          </button>
          <button class="option" data-type="flower" data-value="tulip">
            <div>
              <strong>Tulip</strong>
              <p>Tulips are iconic spring-blooming flowers celebrated for their vibrant cup-shaped blooms.</p>
            </div>
            <div class="meta">$20</div>
          </button>
        </div>

        <div class="help">
          Help:<br>
          Choose between 1 to 3 flowers. Multiple selections allowed. Select a flower by clicking inside the surrounding box and unselect it click once again.
        </div>
      </div>

      <div class="step">
        <h2 class="step-title">Arrangement</h2>
        <div class="options">
          <button class="option active" data-type="arrangement" data-value="bouquet">
            <div>
              <strong>Bouquet</strong>
              <p>The classic way to express your love and gratitude.</p>
            </div>
            <div class="meta">$30</div>
          </button>

          <button class="option" data-type="arrangement" data-value="basket">
            <div>
              <strong>Basket</strong>
              <p>A stylish modern alternative to bouquet.</p>
            </div>
            <div class="meta">$25</div>
          </button>
          <button class="option" data-type="arrangement" data-value="vase">
            <div>
              <strong>Vase</strong>
              <p>The best way to decorate your home and office with flowers.</p>
            </div>
            <div class="meta">$20</div>
          </button>
          <button class="option" data-type="arrangement" data-value="box">
            <div>
              <strong>Box</strong>
              <p>The simple and graceful arrangement of flowers.</p>
            </div>
            <div class="meta">$10</div>
          </button>
        </div>

        <div class="help">
          Help:<br>
          If you choose bouquet, we will wrap your flowers in a beautiful paper and tie them with a ribbon that matches
          the color that you choose bellow.
        </div>
      </div>

      <div class="step">
        <h2 class="step-title">Color</h2>

        <div class="color-options">
          <button
            class="color-card active"
            data-type="color"
            data-value="rose"
          >
            <div class="swatch rose"></div>
            <strong>Rose</strong>
            <span>Light shades of rose</span>
          </button>

          <button
            class="color-card"
            data-type="color"
            data-value="red"
          >
            <div class="swatch red"></div>
            <strong>Red</strong>
            <span>Bright red</span>
          </button>

          <button
            class="color-card"
            data-type="color"
            data-value="green"
          >
            <div class="swatch green"></div>
            <strong>Green</strong>
            <span>Different shades of green</span>
          </button>

          <button
            class="color-card"
            data-type="color"
            data-value="blue"
          >
            <div class="swatch blue"></div>
            <strong>Blue</strong>
            <span>Light shades of blue</span>
          </button>
        </div>
        <div class="help">
          Help:<br>
          We try to apply your chosen color wherever appropriate. For example, we choose roses and wrapping paper etc.
          in your chosen color.
        </div>
      </div>

      <div class="summary">
        <h3>$99.00</h3>
        <div class="summary-line" id="summaryLine">Rose, Tulip | Bouquet | Red</div>

        <button class="cart">Add to Cart</button>
        <br>
        <br>
        <button class="cart">Checkout</button>

        <div class="proof">
          <div>
            <strong>Premium delivery</strong>
            <span>Delivered within hours</span>
          </div>
          <div>
            <strong>Freshness guaranteed</strong>
            <span>Fresh flowers from our own garden</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

{% stylesheet %}
  :root {
    --bg: #f5f5f7;
    --card: #ffffff;
    --text: #1d1d1f;
    --muted: #6e6e73;
    --line: #d2d2d7;
    --dark: #08101d;
    --red: #ff3b2f;
    --rose-light: #efc6e7;
    --rose-dark: #e993d8;
    --red-light: #e9797c;
    --red-dark: #ab2522;
    --green-light: #62d236;
    --green-dark: #3b851e;
    --blue-light: #4ec2f1;
    --blue-dark: #3144ee;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
    background: var(--bg);
    color: var(--text);
  }
  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 46px 22px 80px;
  }

  .header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: end;
    margin-bottom: 34px;
  }

  h1 {
    margin: 0;
    font-size: clamp(25px, 6vw, 50px);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .layout {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 34px;
    align-items: start;
  }

  .visual {
    position: sticky;
    top: 84px;
  }

  .visual-card {
    background: linear-gradient(180deg, #ffffff, #eef0f4);
    border-radius: 34px;
    min-height: 690px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .visual-contents {
    width: 300px;
    height: 430px;
    position: relative;
    z-index: 2;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  .body {
    position: absolute;
    left: 50%;
    top: 86px;
    transform: translateX(-50%);
    width: 190px;
    height: 304px;
    border-radius: 36px 36px 20px 20px;
    background: linear-gradient(160deg, #2a3850, #101826 72%);
    box-shadow: inset 0 0 36px rgba(255, 255, 255, 0.06), 0 24px 60px rgba(0, 0, 0, 0.18);
  }

  .config {
    display: grid;
    gap: 26px;
  }

  .config-intro {
    background: var(--card);
    border-radius: 28px;
    padding: 26px;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .config-intro h2 {
    margin: 0 0 8px;
    font-size: 28px;
    letter-spacing: -0.03em;
  }

  .config-intro p {
    margin: 0;
    color: var(--muted);
    line-height: 1.45;
  }

  .step {
    background: var(--card);
    border-radius: 28px;
    padding: 26px;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .step-title {
    margin: 0 0 18px;
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .step-title span {
    color: var(--muted);
    font-weight: 500;
  }

  .options {
    display: grid;
    gap: 12px;
  }

  .option {
    width: 100%;
    text-align: left;
    background: #fff;
    border: 1.5px solid var(--line);
    border-radius: 18px;
    padding: 18px;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
  }

  .option:hover {
    border-color: #86868b;
  }

  .option.active {
    border-color: #1d1d1f;
    box-shadow: 0 0 0 1px #1d1d1f inset;
  }

  .option strong {
    display: block;
    font-size: 17px;
    margin-bottom: 6px;
  }

  .option p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.4;
  }

  .option .meta {
    color: var(--muted);
    font-size: 14px;
    white-space: nowrap;
    padding-top: 2px;
  }

  .color-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .color-card {
    border: 1.5px solid var(--line);
    border-radius: 18px;
    padding: 18px;
    background: #fff;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .color-card.active {
    border-color: #1d1d1f;
    box-shadow: 0 0 0 1px #1d1d1f inset;
  }

  .swatch {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    margin-bottom: 12px;
    border: 1px solid rgba(0, 0, 0, 0.12);
  }

  .rose {
    background: linear-gradient(145deg, var(--rose-light), var(--rose-dark));
  }
  .red {
    background: linear-gradient(145deg, var(--red-light), var(--red-dark));
  }
  .green {
    background: linear-gradient(145deg, var(--green-light), var(--green-dark));
  }
  .blue {
    background: linear-gradient(145deg, var(--blue-light), var(--blue-dark));
  }

  .color-card strong {
    display: block;
    font-size: 16px;
  }

  .color-card span {
    display: block;
    margin-top: 5px;
    color: var(--muted);
    font-size: 13px;
  }

  .size-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .size-btn {
    height: 58px;
    border-radius: 16px;
    border: 1.5px solid var(--line);
    background: #fff;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
  }

  .size-btn.active {
    border-color: #1d1d1f;
    box-shadow: 0 0 0 1px #1d1d1f inset;
  }

  .help {
    margin-top: 14px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding-top: 15px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .summary {
    background: #1d1d1f;
    color: #fff;
    border-radius: 28px;
    padding: 26px;
  }

  .summary h3 {
    margin: 0 0 12px;
    font-size: 24px;
    letter-spacing: -0.025em;
  }

  .summary-line {
    color: #d6d6d8;
    font-size: 15px;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .cart {
    width: 100%;
    height: 56px;
    border: 0;
    border-radius: 16px;
    background: var(--red);
    color: #fff;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
  }

  .proof {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .proof div {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 15px;
    padding: 12px;
  }

  .proof strong {
    display: block;
    font-size: 18px;
  }

  .proof span {
    color: #b8b8bd;
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .header {
      display: block;
    }

    .price {
      text-align: left;
      margin-top: 14px;
    }

    .layout {
      display: flex;
      flex-direction: column;
    }

    .visual {
      position: static;
      order: 2;
    }

    .config {
      order: 1;
    }

    .visual-card {
      min-height: 520px;
    }

    .color-options {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .nav-links {
      gap: 12px;
      font-size: 12px;
    }

    .wrap {
      padding: 28px 14px 60px;
    }

    .step,
    .config-intro,
    .summary {
      padding: 21px;
      border-radius: 24px;
    }

    .option {
      grid-template-columns: 1fr;
    }

    .option .meta {
      white-space: normal;
    }

    .size-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .proof {
      grid-template-columns: 1fr;
    }
  }

  .render {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    gap: 4px;
    height: 100%;
    margin: 8px;
  }

  .render-flower {
    padding: 4px;
    text-transform: capitalize;
    width: 100%;
    text-align: center;
    font-size: xx-large;
  }

  .render-flower-error {
    padding: 4px;
    width: 100%;
    text-align: center;
    color: var(--red);
  }

  .render-flowers {
    border: 1.5px solid var(--line);
    border-radius: 16px;
    padding: 20px 4px;
    display: flex;
    gap: 4px;
    align-items: center;
    justify-content: space-around;
    width: 100%;
    flex-wrap: wrap;
  }

  .render-item {
    border: 1.5px solid var(--line);
    border-radius: 16px;
    padding: 20px 4px;
    text-transform: capitalize;
    width: 100%;
    text-align: center;
    font-size: xx-large;
  }
{% endstylesheet %}

{% javascript %}
  const initialState = {
    flower: ['rose'],
    arrangement: 'bouquet',
    color: 'rose',
  };

  const proxy = (initialData) => {
    // The target object is private to this function's scope
    const target = { ...initialData };

    const proxy = new Proxy(target, {
      set(obj, prop, value) {
        console.log(`Updating ${prop} to ${value}`);
        obj[prop] = value;
        render(target);
        return true;
      },
      get(obj, prop) {
        return obj[prop];
      },
    });

    proxy.flower = initialData.flower;
    proxy.arrangement = initialData.arrangement;
    proxy.color = initialData.color;

    // Return only the proxy
    return proxy;
  };

  const stateProxy = proxy(initialState);

  document.querySelectorAll("[data-type='flower']").forEach((button) => {
    button.addEventListener('click', () => {
      let flowers = [];
      button.classList.toggle('active');

      document.querySelectorAll("[data-type='flower']").forEach((btn) => {
        if (btn.classList.contains('active')) {
          flowers.push(btn.dataset.value);
        }
      });

      stateProxy.flower = flowers;
    });
  });

  document.querySelectorAll("[data-type='arrangement']").forEach((button) => {
    button.addEventListener('click', () => {
      document.querySelectorAll("[data-type='arrangement']").forEach((btn) => btn.classList.remove('active'));
      button.classList.add('active');
      stateProxy.arrangement = button.dataset.value;
    });
  });

  document.querySelectorAll("[data-type='color']").forEach((button) => {
    button.addEventListener('click', () => {
      document.querySelectorAll("[data-type='color']").forEach((btn) => btn.classList.remove('active'));
      button.classList.add('active');
      stateProxy.color = button.dataset.value;
    });
  });

  function render(state) {
    const visualContents = document.getElementById('visual-contents');

    const flowers = state.flower.length < 1 || state.flower.length > 3 ? '<div class=render-flower-error>Error <br>  Choose between 1 to 3 flowers</div>' : state.flower.map((x) => `<div class=render-flower>${x}</div>`).join(' ');

    if (visualContents) {
      visualContents.innerHTML = `
        <div class="render">
        <div class="render-flowers"> ${flowers}</div>
        <div class=render-item>${state.arrangement}</div>
        <div class="swatch ${state.color}">
        </div>
      `;
    }

    visualContents.style.opacity = '0';
    visualContents.style.transform = 'translateY(8px)';

    setTimeout(() => {
      visualContents.style.opacity = '1';
      visualContents.style.transform = 'translateY(0)';
    }, 160);
  }
{% endjavascript %}

